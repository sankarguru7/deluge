/*
 * Create a Work Order in Zoho FSM using Deluge
 *
 * Troubleshooting "Unable to Update Grand Total" & "Error while populating missing fields":
 * 1. This error often occurs when the Service/Product ID is passed as a string,
 *    but the API expects an object, or when pricing/tax fields are missing.
 * 2. Ensure you use REAL IDs from your environment for Contact, Territory, and Service.
 */

// 1. Define IDs (REPLACE WITH YOUR ACTUAL IDs)
contactId = "2373000000232155";
territoryId = "2373000000205267";
serviceId = "2373000000214003";
serviceAddressId = "2373000000232160";
billingAddressId = "2373000000232159";

// 2. Construct Service Line Items
serviceLineItems = List();
lineItem1 = Map();

/*
 * FIX: Many Zoho APIs now require the Product/Service to be an object with an 'id'.
 * Also, providing Unit_Price and Discount can help the system calculate the Grand Total.
 */
lineItem1.put("Service", {"id": serviceId});
lineItem1.put("Quantity", 1);
lineItem1.put("Unit_Price", 0.0); // Set to actual price or 0.0
lineItem1.put("Discount", 0.0);
lineItem1.put("Sequence", 1);

serviceLineItems.add(lineItem1);

// 3. Construct the Work Order data map
workOrderData = Map();
workOrderData.put("Summary", "Work Order - " + zoho.currenttime);
workOrderData.put("Type", "Service");
workOrderData.put("Contact", {"id": contactId}); // Try object format for Contact too
workOrderData.put("Territory", {"id": territoryId}); // Try object format for Territory
workOrderData.put("Service_Address", {"id": serviceAddressId});
workOrderData.put("Billing_Address", {"id": billingAddressId});
workOrderData.put("Service_Line_Items", serviceLineItems);

// 4. Wrap the data in a list under the 'data' key
payload = Map();
payload.put("data", {workOrderData});

// 5. Execute the API Request
// toJSONString() ensures the payload is formatted correctly for the API
response = invokeurl
[
	url :"https://fsm.zoho.com/fsm/v1/Work_Orders"
	type :POST
	parameters :payload.toJSONString()
	headers :{"Content-Type":"application/json"}
	connection :"zohofsm" // Replace with your actual connection link name
];

// 6. Debugging
info response;
