// Replace these variables with actual values
organization_id = "10234695";
purchaseorder_id = "4815000000044972";
connection_name = "zoho_inventory_connection"; // Replace with your actual connection name

// Build the payload as a Map
payload = Map();
payload.put("purchaseorder_number", "PO-00002");
payload.put("date", "2015-05-28");
