payload.put("ship_via", "FedEx");
payload.put("vendor_id", 4815000000044080);
payload.put("salesorder_id", 4815000000044936);
payload.put("is_drop_shipment", true);

contact_person = Map();
contact_person.put("contact_person_id", 4815000000044080);
comm_pref = Map();
comm_pref.put("is_email_enabled", true);
comm_pref.put("is_whatsapp_enabled", true);
contact_person.put("communication_preference", comm_pref);
payload.put("contact_persons_associated", {contact_person});

payload.put("attention", "Tony");
payload.put("delivery_org_address_id", 4815000000044077);
payload.put("delivery_customer_id", 4815000000044066);
payload.put("notes", "Sample Note");
payload.put("terms", "Terms and Conditions");
