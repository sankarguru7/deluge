purchaseorder = po_data.get("purchaseorder");
purchaseorder_id = purchaseorder.get("purchaseorder_id");

// Build the update payload as a Map
payload = Map();
payload.put("purchaseorder_number", purchaseorder.get("purchaseorder_number"));
payload.put("date", purchaseorder.get("date"));
payload.put("expected_delivery_date", purchaseorder.get("expected_delivery_date"));
payload.put("reference_number", purchaseorder.get("reference_number"));
payload.put("vendor_id", purchaseorder.get("vendor_id"));
payload.put("attention", purchaseorder.get("attention"));
payload.put("delivery_org_address_id", purchaseorder.get("delivery_org_address_id"));
payload.put("delivery_customer_id", purchaseorder.get("delivery_customer_id"));
payload.put("notes", purchaseorder.get("notes"));
payload.put("terms", purchaseorder.get("terms"));
payload.put("exchange_rate", purchaseorder.get("exchange_rate"));

// Extract line items from fetched data and prepare with for each loop
fetched_line_items = purchaseorder.get("line_items");
updated_line_items = List();

for each  item in fetched_line_items
{
	line_item = Map();
	line_item.put("item_id", item.get("item_id"));
	line_item.put("line_item_id", item.get("line_item_id"));
	line_item.put("account_id", item.get("account_id"));
	line_item.put("name", item.get("name"));
	line_item.put("description", item.get("description"));
	line_item.put("item_order", item.get("item_order"));
	line_item.put("bcy_rate", item.get("bcy_rate"));
	line_item.put("purchase_rate", item.get("rate")); // rate is usually mapped to purchase_rate
	line_item.put("quantity", item.get("quantity"));
	line_item.put("unit", item.get("unit"));
	line_item.put("item_total", item.get("item_total"));

	// Add optional tax details if present
	if(item.get("tax_id") != "")
	{
		line_item.put("tax_id", item.get("tax_id"));
		line_item.put("tax_name", item.get("tax_name"));
		line_item.put("tax_type", item.get("tax_type"));
		line_item.put("tax_percentage", item.get("tax_percentage"));
	}

	line_item.put("hsn_or_sac", item.get("hsn_or_sac"));
	line_item.put("location_id", item.get("location_id"));

	updated_line_items.add(line_item);
}

payload.put("line_items", updated_line_items);

payload.put("location_id", purchaseorder.get("location_id"));
payload.put("gst_treatment", purchaseorder.get("gst_treatment"));
payload.put("tax_treatment", purchaseorder.get("tax_treatment"));
payload.put("gst_no", purchaseorder.get("gst_no"));
payload.put("source_of_supply", purchaseorder.get("source_of_supply"));
payload.put("destination_of_supply", purchaseorder.get("destination_of_supply"));

// Set headers based on best practices: always include Content-Type application/json
headers_data = Map();
headers_data.put("Content-Type", "application/json");

// Construct the API URL
api_url = "https://www.zohoapis.com/inventory/v1/purchaseorders/" + purchaseorder_id + "?organization_id=" + organization_id;

// Invoke URL using connection (avoiding hardcoded authorization tokens per best practices)
// Also using .toString() on the payload per best practices
response = invokeUrl
[
	url: api_url
	type: PUT
	headers: headers_data
	parameters: payload.toString()
	connection: connection_name
];

info response;
